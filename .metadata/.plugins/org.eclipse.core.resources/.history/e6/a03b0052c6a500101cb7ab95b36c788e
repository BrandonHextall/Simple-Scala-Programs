package lib;

import java.util.*;

public class Register {
	
	//Fields
	private ArrayList<Name> list;
	private int capacity;
	
	//Constructors
	/** Creates new instance of Register using default values.  Default capacity is 25*/
	public Register() {
		list = new ArrayList<Name>();
		capacity = 25;
	}
	
	/** Creates new instance of Register using given capacity. */
	public Register(int capacity) {
		list = new ArrayList<Name>();
		capacity = capacity;
	}
	
	//Methods
	/* Adds a new name to register. */
	public void addName(Name name) {
		list.add(name);
	}
	
	/** Returns name in register based on index. 
	 * @param index position of name to return*/
	public Name getName(int index) {
		return list[index];
	}
	
	/** Returns the register. 
	 * @return register*/
	public ArrayList getRegister() {
		return list;
	}
	
	/** Returns capacity of register.
	 * @return capacity of register. */
	public int getCapacity() {
		 return capacity;
	}
	
	/** Returns size of register.
	 * @return size of */
	public int getRegisterSize() {
		return list.size();
	}
	 
	/** Removes name from register based on index.
	  * @param index position to remove. */
	public void removeName(int index) {
		list.remove(index);
	}
}
